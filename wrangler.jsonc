{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rack-builder",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "rackedview.com/*",
      "zone_name": "rackedview.com"
    },
    {
      "pattern": "www.rackedview.com/*",
      "zone_name": "rackedview.com"
    }
  ]
}